# Copier ce fichier en .env.local et renseigner les vraies valeurs.
# Ne jamais committer .env.local (déjà ignoré par .gitignore).

# --- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://yuba-bijoux.com

# --- Supabase (Phase 1) --------------------------------------------------
# Project Settings > API dans le dashboard Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : contourne RLS. Serveur uniquement, jamais NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (Phase 1) ----------------------------------------------
# Cloudflare Dashboard > R2 > Manage API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=yuba-media
# Sous-domaine public r2.dev du bucket (fallback si pas de domaine perso).
NEXT_PUBLIC_R2_PUBLIC_HOSTNAME=pub-xxxxxxxx.r2.dev
# Domaine personnalisé branché sur le bucket R2 (prioritaire sur R2_PUBLIC_HOSTNAME).
NEXT_PUBLIC_CDN_HOSTNAME=cdn.yuba-bijoux.com

# --- Konnect (Phase 3) — paiement carte bancaire --------------------------
# konnect.network > Tableau de bord > API.
KONNECT_API_KEY=
KONNECT_WALLET_ID=
# Sandbox : https://api.sandbox.konnect.network/api/v2
# Production : https://api.konnect.network/api/v2
KONNECT_BASE_URL=https://api.sandbox.konnect.network/api/v2
KONNECT_WEBHOOK_SECRET=

# --- Resend (Phase 3) — emails transactionnels ----------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=commandes@yuba-bijoux.com

# --- Meta Pixel & Conversions API (Phase 5) -------------------------------
NEXT_PUBLIC_META_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=

# --- Analytics (Phase 5) ---------------------------------------------------
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=
